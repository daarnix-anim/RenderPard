<Window x:Class="RenderPard.UI.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        mc:Ignorable="d"
        Title="{DynamicResource TrimTitle}" Height="620" Width="880" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AnipardWindowStyle}"
        Background="{StaticResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:IconNameToImageSourceConverter x:Key="IconNameToImageSourceConverter"/>
        <local:BooleanToPlayPauseTextConverter x:Key="BooleanToPlayPauseTextConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Custom Slider Style for Timeline -->
        <Style x:Key="TimelineSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0" Template="{x:Null}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0" Template="{x:Null}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border Background="#f39c12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                                    <Rectangle Width="2" Height="10" Fill="#1E2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="✂" FontSize="13" Foreground="{StaticResource AppLinkBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource TrimTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — " FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VIDEO PLAYER VIEWPORT -->
        <Border Grid.Row="1" Background="#0A0B0D" Margin="10,10,10,6" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="PlayerMediaElement"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              MediaOpened="PlayerMediaElement_MediaOpened"
                              MediaEnded="PlayerMediaElement_MediaEnded"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"/>

                <!-- Audio Waveform / Placeholder icon for audio files -->
                <StackPanel x:Name="AudioVisualIndicator" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="64" Height="64" Background="#1E2026" CornerRadius="32" BorderBrush="{StaticResource AppLinkBrush}" BorderThickness="2" HorizontalAlignment="Center">
                        <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource AppTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Top-Right Timecode HUD overlay -->
                <Border Background="#CC000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,4">
                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="#f39c12" FontFamily="Consolas, Courier New" FontWeight="Bold" FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <!-- TIMELINE & PLAYHEAD & BRACKETS -->
        <Border Grid.Row="2" Margin="10,0,10,6" Background="#15171C" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,8">
            <StackPanel>
                <!-- Interactive Timeline Range Bar -->
                <Grid Height="30" Margin="0,0,0,4">
                    <!-- Timeline Track Background -->
                    <Border Height="10" Background="#242833" CornerRadius="4" VerticalAlignment="Center"/>

                    <!-- Highlighted In-Out Active Range Area -->
                    <Canvas Height="10" VerticalAlignment="Center">
                        <Border x:Name="TrimHighlightBar" Height="10" Background="#B3F39C12" CornerRadius="3" BorderBrush="#F39C12" BorderThickness="1"/>
                    </Canvas>

                    <!-- In-Point Bracket Visual -->
                    <Canvas Height="24" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border x:Name="InBracketMarker" Width="8" Height="20" Background="#f39c12" CornerRadius="2,0,0,2" BorderBrush="#FFFFFF" BorderThickness="1,1,0,1">
                            <TextBlock Text="[" FontSize="10" FontWeight="Bold" Foreground="#1E2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Canvas>

                    <!-- Out-Point Bracket Visual -->
                    <Canvas Height="24" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border x:Name="OutBracketMarker" Width="8" Height="20" Background="#f39c12" CornerRadius="0,2,2,0" BorderBrush="#FFFFFF" BorderThickness="0,1,1,1">
                            <TextBlock Text="]" FontSize="10" FontWeight="Bold" Foreground="#1E2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Canvas>

                    <!-- Main Timeline Playhead Slider -->
                    <Slider x:Name="TimelineSlider"
                            Style="{StaticResource TimelineSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding TotalDurationSeconds}"
                            Value="{Binding CurrentTimeSeconds, Mode=TwoWay}"
                            ValueChanged="TimelineSlider_ValueChanged"
                            PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                            PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Transport Bar Controls -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: In/Out Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding SetInPointCommand}" Content="{DynamicResource TrimBtnIn}" Width="75" Height="26" Margin="0,0,5,0" FontWeight="SemiBold" ToolTip="Установить точку входа [I]"/>
                        <Button Command="{Binding SetOutPointCommand}" Content="{DynamicResource TrimBtnOut}" Width="75" Height="26" Margin="0,0,5,0" FontWeight="SemiBold" ToolTip="Установить точку выхода [O]"/>
                        <Button Command="{Binding ResetTrimCommand}" Content="{DynamicResource TrimReset}" Width="70" Height="26" Margin="0,0,5,0" Background="Transparent" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Center: Playback Transport Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding JumpToInPointCommand}" Content="|◀" Width="32" Height="26" Margin="0,0,4,0" ToolTip="К точке входа (In)"/>
                        <Button Command="{Binding StepFrameBackwardCommand}" Content="◀ 1к" Width="40" Height="26" Margin="0,0,4,0" ToolTip="Назад на 1 кадр (←)"/>
                        <Button Command="{Binding TogglePlayCommand}" Width="48" Height="26" Margin="0,0,4,0" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" ToolTip="Воспроизведение / Пауза (Space)">
                            <TextBlock Text="{Binding IsPlaying, Converter={StaticResource BooleanToPlayPauseTextConverter}}" FontWeight="Bold" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding StepFrameForwardCommand}" Content="1к ▶" Width="40" Height="26" Margin="0,0,4,0" ToolTip="Вперед на 1 кадр (→)"/>
                        <Button Command="{Binding JumpToOutPointCommand}" Content="▶|" Width="32" Height="26" Margin="0,0,4,0" ToolTip="К точке выхода (Out)"/>
                    </StackPanel>

                    <!-- Right: Timecode Display -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTimeText}" Foreground="{StaticResource AppTextBrush}" FontFamily="Consolas, Courier New" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text=" / " Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalDurationText}" Foreground="{StaticResource AppTextSecondaryBrush}" FontFamily="Consolas, Courier New" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BOTTOM CONTROLS & EXPORT PANEL -->
        <Border Grid.Row="3" Margin="10,0,10,6" Background="#15171C" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Exact Millisecond Input Boxes -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource TrimInPoint}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding InPointText, UpdateSourceTrigger=LostFocus}" Width="100" Height="24" FontFamily="Consolas, Courier New" FontSize="11" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource TrimOutPoint}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding OutPointText, UpdateSourceTrigger=LostFocus}" Width="100" Height="24" FontFamily="Consolas, Courier New" FontSize="11" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="{DynamicResource TrimDuration}" FontSize="11" Foreground="{StaticResource AppLinkBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedDurationText, Mode=OneWay}" Width="100" Height="24" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppLinkBrush}" TextAlignment="Center" IsReadOnly="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Preset Selection -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0">
                    <TextBlock Text="{DynamicResource TrimPreset}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" Height="26" IsEnabled="{Binding IsLosslessCopy, Converter={StaticResource InverseBooleanConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="{DynamicResource TrimLossless}" IsChecked="{Binding IsLosslessCopy}" Margin="0,6,0,0" Foreground="{StaticResource AppTextBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddToQueueCommand}" Content="{DynamicResource TrimAddToQueue}" Height="34" Padding="14,0" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button Command="{Binding RenderNowCommand}" Content="{DynamicResource TrimExportNow}" Height="34" Padding="16,0" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER: HOTKEYS BAR -->
        <Border Grid.Row="4" Background="{StaticResource AppBackgroundSecondaryBrush}" Padding="10,0">
            <TextBlock Text="{DynamicResource TrimHotkeysHelp}" FontSize="10.5" Foreground="{StaticResource AppTextSecondaryBrush}" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
