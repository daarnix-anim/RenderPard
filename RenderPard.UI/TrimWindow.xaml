<Window x:Class="RenderPard.UI.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        mc:Ignorable="d"
        Title="{DynamicResource TrimTitle}" Height="620" Width="880" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AnipardWindowStyle}"
        Background="{StaticResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:IconNameToImageSourceConverter x:Key="IconNameToImageSourceConverter"/>
        <local:BooleanToPlayPauseTextConverter x:Key="BooleanToPlayPauseTextConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>

        <!-- Crop Segmented Button Style -->
        <Style x:Key="CropToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#242833"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#f39c12"/>
                                <Setter Property="Foreground" Value="#1E2026"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crop Handle Corner Style -->
        <Style x:Key="CropCornerHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#f39c12" BorderBrush="#FFFFFF" BorderThickness="1.5" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crop Handle Edge Horizontal Style -->
        <Style x:Key="CropEdgeHHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#f39c12" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crop Handle Edge Vertical Style -->
        <Style x:Key="CropEdgeVHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#f39c12" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Slider Style for Timeline with True Click-to-Point Support -->
        <Style x:Key="TimelineSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border Background="#f39c12" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                                    <Rectangle Width="2" Height="10" Fill="#1E2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="✂" FontSize="13" Foreground="{StaticResource AppLinkBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource TrimTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — " FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VIDEO PLAYER VIEWPORT & CROP OVERLAY -->
        <Border Grid.Row="1" Background="#0A0B0D" Margin="10,10,10,6" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True" SizeChanged="PlayerViewport_SizeChanged">
            <Grid x:Name="PlayerContainerGrid">
                <MediaElement x:Name="PlayerMediaElement"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              ScrubbingEnabled="True"
                              MediaOpened="PlayerMediaElement_MediaOpened"
                              MediaEnded="PlayerMediaElement_MediaEnded"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"/>

                <!-- Audio Waveform / Placeholder icon for audio files -->
                <StackPanel x:Name="AudioVisualIndicator" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="64" Height="64" Background="#1E2026" CornerRadius="32" BorderBrush="{StaticResource AppLinkBrush}" BorderThickness="2" HorizontalAlignment="Center">
                        <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource AppTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Interactive Crop Overlay Canvas -->
                <Canvas x:Name="CropCanvas"
                        Visibility="{Binding IsCropActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="Transparent"
                        ClipToBounds="True">
                    
                    <!-- 4 Dark Mask Borders surrounding the crop rectangle -->
                    <Border x:Name="MaskTop" Background="#A6000000" IsHitTestVisible="False"/>
                    <Border x:Name="MaskBottom" Background="#A6000000" IsHitTestVisible="False"/>
                    <Border x:Name="MaskLeft" Background="#A6000000" IsHitTestVisible="False"/>
                    <Border x:Name="MaskRight" Background="#A6000000" IsHitTestVisible="False"/>

                    <!-- Movable & Resizable Crop Box -->
                    <Grid x:Name="CropBoxGrid">
                        <!-- Main Glowing Amber Border -->
                        <Border BorderBrush="#f39c12" BorderThickness="2" Background="Transparent" IsHitTestVisible="False"/>

                        <!-- Center Drag Area for Moving the Whole Box (Excludes Thumbs) -->
                        <Rectangle x:Name="CropCenterDragArea"
                                   Fill="#14F39C12"
                                   Cursor="SizeAll"
                                   MouseLeftButtonDown="CropCenterDragArea_MouseLeftButtonDown"
                                   MouseLeftButtonUp="CropCenterDragArea_MouseLeftButtonUp"
                                   MouseMove="CropCenterDragArea_MouseMove"/>

                        <!-- Rule of Thirds 3x3 Grid Lines -->
                        <Grid IsHitTestVisible="False" Opacity="0.35">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#f39c12" BorderThickness="0,1,0,1"/>
                            <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#f39c12" BorderThickness="1,0,1,0"/>
                        </Grid>

                        <!-- Crop Info Badge -->
                        <Border Background="#E615171C" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Padding="5,2" BorderBrush="#f39c12" BorderThickness="1" IsHitTestVisible="False">
                            <TextBlock Text="{Binding CropInfoText}" Foreground="#f39c12" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas, Courier New"/>
                        </Border>

                        <!-- 8 Resize Thumbs (Corners & Edges) -->
                        <Thumb x:Name="HandleNW" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0" Style="{StaticResource CropCornerHandleStyle}" Cursor="SizeNWSE" DragStarted="CropHandle_DragStarted" DragDelta="HandleNW_DragDelta"/>
                        <Thumb x:Name="HandleNE" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Style="{StaticResource CropCornerHandleStyle}" Cursor="SizeNESW" DragStarted="CropHandle_DragStarted" DragDelta="HandleNE_DragDelta"/>
                        <Thumb x:Name="HandleSW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6" Style="{StaticResource CropCornerHandleStyle}" Cursor="SizeNESW" DragStarted="CropHandle_DragStarted" DragDelta="HandleSW_DragDelta"/>
                        <Thumb x:Name="HandleSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6" Style="{StaticResource CropCornerHandleStyle}" Cursor="SizeNWSE" DragStarted="CropHandle_DragStarted" DragDelta="HandleSE_DragDelta"/>

                        <Thumb x:Name="HandleN" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" Style="{StaticResource CropEdgeHHandleStyle}" Cursor="SizeNS" DragStarted="CropHandle_DragStarted" DragDelta="HandleN_DragDelta"/>
                        <Thumb x:Name="HandleS" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3" Style="{StaticResource CropEdgeHHandleStyle}" Cursor="SizeNS" DragStarted="CropHandle_DragStarted" DragDelta="HandleS_DragDelta"/>
                        <Thumb x:Name="HandleW" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-3,0,0,0" Style="{StaticResource CropEdgeVHandleStyle}" Cursor="SizeWE" DragStarted="CropHandle_DragStarted" DragDelta="HandleW_DragDelta"/>
                        <Thumb x:Name="HandleE" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-3,0" Style="{StaticResource CropEdgeVHandleStyle}" Cursor="SizeWE" DragStarted="CropHandle_DragStarted" DragDelta="HandleE_DragDelta"/>
                    </Grid>
                </Canvas>

                <!-- Top-Left Crop Mode Toolbar (Overlaid on Player) -->
                <Border Background="#E615171C" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="4,3" BorderBrush="#2D3139" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬚" FontSize="12" Foreground="{StaticResource AppLinkBrush}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                        <RadioButton Content="{DynamicResource CropOff}" IsChecked="{Binding CropMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=None}" Style="{StaticResource CropToggleButtonStyle}"/>
                        <RadioButton Content="{DynamicResource Crop9x16}" IsChecked="{Binding CropMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Vertical9x16}" Style="{StaticResource CropToggleButtonStyle}" ToolTip="Вертикальное 9:16 (TikTok, Shorts, Reels)"/>
                        <RadioButton Content="{DynamicResource Crop16x9}" IsChecked="{Binding CropMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Horizontal16x9}" Style="{StaticResource CropToggleButtonStyle}" ToolTip="Горизонтальное 16:9 (Стандарт)"/>
                        <RadioButton Content="{DynamicResource Crop1x1}" IsChecked="{Binding CropMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Square1x1}" Style="{StaticResource CropToggleButtonStyle}" ToolTip="Квадратное 1:1 (Посты, Аватары)"/>
                        <RadioButton Content="{DynamicResource CropCustom}" IsChecked="{Binding CropMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Custom}" Style="{StaticResource CropToggleButtonStyle}" ToolTip="Свободный кроп (растягивание мышью)"/>
                    </StackPanel>
                </Border>

                <!-- Top-Right Timecode HUD overlay -->
                <Border Background="#CC000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4">
                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="#f39c12" FontFamily="Consolas, Courier New" FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- TIMELINE & PLAYHEAD & BRACKETS & PREMIERE-STYLE ZOOM NAVIGATOR -->
        <Border Grid.Row="2" Margin="10,0,10,6" Background="#15171C" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,6">
            <StackPanel>
                <!-- Premiere / After Effects Style Zoom Navigator Bar -->
                <Grid x:Name="MiniNavigatorGrid" Height="18" Margin="0,0,0,4" Background="Transparent"
                      PreviewMouseLeftButtonDown="MiniNavigator_PreviewMouseLeftButtonDown">
                    <!-- Full Track Background -->
                    <Border Height="8" Background="#1E222A" CornerRadius="4" VerticalAlignment="Center" Margin="2,0" IsHitTestVisible="False"/>

                    <!-- Full In-Out Range in Mini-Bar -->
                    <Canvas Height="8" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False">
                        <Border x:Name="MiniInHighlight" Height="8" Background="#80F39C12" CornerRadius="3"/>
                    </Canvas>

                    <!-- Multi-Segment Markers Canvas on Mini-Bar -->
                    <Canvas x:Name="MiniSegmentsCanvas" Height="8" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False"/>

                    <!-- Mini Playhead marker -->
                    <Canvas Height="14" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border x:Name="MiniPlayheadMarker" Width="3" Height="14" Background="#FFFFFF" CornerRadius="1.5" HorizontalAlignment="Left"/>
                    </Canvas>

                    <!-- Draggable & Resizable Premiere Zoom Viewport Box -->
                    <Canvas Height="18" VerticalAlignment="Center">
                        <Grid x:Name="MiniViewportGrid" Height="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>

                            <!-- Background highlight -->
                            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#3300C8FF" BorderBrush="#00C8FF" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False"/>

                            <!-- Left Zoom Handle (Drag to compress/expand left edge) -->
                            <Thumb x:Name="MiniZoomHandleLeft" Grid.Column="0" Cursor="SizeWE" DragDelta="MiniZoomHandleLeft_DragDelta">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#00C8FF" CornerRadius="2,0,0,2" Margin="0,1,0,1">
                                            <TextBlock Text="‹" FontSize="11" FontWeight="Bold" Foreground="#121418" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <!-- Center Grab Area (Drag to pan viewport) -->
                            <Border x:Name="MiniZoomCenterBar" Grid.Column="1" Background="Transparent" Cursor="SizeAll"
                                    MouseLeftButtonDown="MiniZoomCenterBar_MouseLeftButtonDown"
                                    MouseLeftButtonUp="MiniZoomCenterBar_MouseLeftButtonUp"
                                    MouseMove="MiniZoomCenterBar_MouseMove"/>

                            <!-- Right Zoom Handle (Drag to compress/expand right edge) -->
                            <Thumb x:Name="MiniZoomHandleRight" Grid.Column="2" Cursor="SizeWE" DragDelta="MiniZoomHandleRight_DragDelta">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#00C8FF" CornerRadius="0,2,2,0" Margin="0,1,0,1">
                                            <TextBlock Text="›" FontSize="11" FontWeight="Bold" Foreground="#121418" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Canvas>
                </Grid>

                <!-- Interactive Zoomed Timeline Range Bar (Click or Drag anywhere to Seek) -->
                <Grid x:Name="TimelineTrackGrid" Height="28" Margin="0,0,0,2" Background="Transparent"
                      PreviewMouseLeftButtonDown="TimelineTrackGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="TimelineTrackGrid_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="TimelineTrackGrid_PreviewMouseLeftButtonUp"
                      MouseWheel="TimelineTrack_MouseWheel">
                    
                    <!-- Timeline Track Background -->
                    <Border Height="10" Background="#242833" CornerRadius="4" VerticalAlignment="Center" IsHitTestVisible="False"/>

                    <!-- Highlighted In-Out Active Range Area in Zoomed View -->
                    <Canvas Height="10" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False">
                        <Border x:Name="TrimHighlightBar" Height="10" Background="#B3F39C12" CornerRadius="3" BorderBrush="#F39C12" BorderThickness="1"/>
                    </Canvas>

                    <!-- Multi-Segment Markers Canvas on Zoomed Timeline -->
                    <Canvas x:Name="MainSegmentsCanvas" Height="10" VerticalAlignment="Center" ClipToBounds="True" IsHitTestVisible="False"/>

                    <!-- In-Point Bracket Drag Handle -->
                    <Canvas Height="24" VerticalAlignment="Center" ClipToBounds="True">
                        <Thumb x:Name="InBracketThumb" Width="14" Height="22" Cursor="SizeWE"
                               DragStarted="InBracketThumb_DragStarted" DragDelta="InBracketThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#F39C12" CornerRadius="3,0,0,3" BorderBrush="#FFFFFF" BorderThickness="1.5,1.5,0,1.5"
                                            ToolTip="Левая граница обрезки [In] — потяните для изменения">
                                        <TextBlock Text="[" FontSize="11" FontWeight="Bold" Foreground="#1E2026" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Canvas>

                    <!-- Out-Point Bracket Drag Handle -->
                    <Canvas Height="24" VerticalAlignment="Center" ClipToBounds="True">
                        <Thumb x:Name="OutBracketThumb" Width="14" Height="22" Cursor="SizeWE"
                               DragStarted="OutBracketThumb_DragStarted" DragDelta="OutBracketThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="#F39C12" CornerRadius="0,3,3,0" BorderBrush="#FFFFFF" BorderThickness="0,1.5,1.5,1.5"
                                            ToolTip="Правая граница обрезки [Out] — потяните для изменения">
                                        <TextBlock Text="]" FontSize="11" FontWeight="Bold" Foreground="#1E2026" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Canvas>

                    <!-- Main Timeline Playhead Slider with Direct Click-to-Seek -->
                    <Slider x:Name="TimelineSlider"
                            Style="{StaticResource TimelineSliderStyle}"
                            IsMoveToPointEnabled="True"
                            Minimum="{Binding ViewportStart}"
                            Maximum="{Binding ViewportEnd}"
                            Value="{Binding CurrentTimeSeconds, Mode=TwoWay}"
                            ValueChanged="TimelineSlider_ValueChanged"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Transport Bar Controls -->
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: In/Out & Add Segment Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding SetInPointCommand}" Content="{DynamicResource TrimBtnIn}" Width="70" Height="26" Margin="0,0,4,0" FontWeight="SemiBold" ToolTip="Установить точку входа [I]"/>
                        <Button Command="{Binding SetOutPointCommand}" Content="{DynamicResource TrimBtnOut}" Width="70" Height="26" Margin="0,0,4,0" FontWeight="SemiBold" ToolTip="Установить точку выхода [O]"/>
                        <Button Command="{Binding AddCurrentSegmentCommand}" Content="{DynamicResource TrimAddSegment}" Height="26" Margin="0,0,4,0" Padding="8,0" Background="#1E222A" BorderBrush="{StaticResource AppLinkBrush}" Foreground="{StaticResource AppLinkBrush}" FontWeight="SemiBold" ToolTip="Добавить текущий диапазон In/Out в список фрагментов (Горячая клавиша M)"/>
                        <Button Command="{Binding ResetTrimCommand}" Content="{DynamicResource TrimReset}" Width="65" Height="26" Margin="0,0,4,0" Background="Transparent" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Center: Playback Transport Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding JumpToInPointCommand}" Content="|◀" Width="32" Height="26" Margin="0,0,4,0" ToolTip="К точке входа (In)"/>
                        <Button Command="{Binding StepFrameBackwardCommand}" Content="◀ 1к" Width="40" Height="26" Margin="0,0,4,0" ToolTip="Назад на 1 кадр (←)"/>
                        <Button Command="{Binding TogglePlayCommand}" Width="48" Height="26" Margin="0,0,4,0" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" ToolTip="Воспроизведение / Пауза (Space)">
                            <TextBlock Text="{Binding IsPlaying, Converter={StaticResource BooleanToPlayPauseTextConverter}}" FontWeight="Bold" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding StepFrameForwardCommand}" Content="1к ▶" Width="40" Height="26" Margin="0,0,4,0" ToolTip="Вперед на 1 кадр (→)"/>
                        <Button Command="{Binding JumpToOutPointCommand}" Content="▶|" Width="32" Height="26" Margin="0,0,4,0" ToolTip="К точке выхода (Out)"/>
                    </StackPanel>

                    <!-- Right: Zoom Controls & Timecode Display -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Premiere-style Zoom Scale Controls -->
                        <Border Background="#1C2028" CornerRadius="4" BorderBrush="#2D3139" BorderThickness="1" Padding="4,2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ZoomOutCommand}" Content="−" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="Bold" ToolTip="Уменьшить масштаб"/>
                                <Slider Minimum="1" Maximum="20" Value="{Binding ZoomLevel, Mode=TwoWay}" Width="50" Height="14" Margin="3,0" VerticalAlignment="Center" ToolTip="Масштаб таймлайна (Ctrl + Колесо мыши)"/>
                                <Button Command="{Binding ZoomInCommand}" Content="+" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="Bold" ToolTip="Увеличить масштаб"/>
                                <Button Command="{Binding ResetZoomCommand}" Content="{Binding ZoomText}" Height="18" Padding="3,0" Margin="3,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppLinkBrush}" FontSize="10.5" FontWeight="Bold" ToolTip="Сбросить масштаб до 1x"/>
                            </StackPanel>
                        </Border>

                        <!-- Timecode Display -->
                        <TextBlock Text="{Binding CurrentTimeText}" Foreground="{StaticResource AppTextBrush}" FontFamily="Consolas, Courier New" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text=" / " Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalDurationText}" Foreground="{StaticResource AppTextSecondaryBrush}" FontFamily="Consolas, Courier New" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Multi-Segment Panel (Shown when segments exist) -->
                <Border Visibility="{Binding HasSegments, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#121418" CornerRadius="4" BorderBrush="#282D36" BorderThickness="1" Margin="0,6,0,0" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title & Count -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="📑" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource TrimSegmentsTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppLinkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center: Horizontal Scrollable List of Segment Cards -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" BorderThickness="1.5" Margin="0,0,6,0" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1C2028"/>
                                                    <Setter Property="BorderBrush" Value="#333945"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#252A35"/>
                                                            <Setter Property="BorderBrush" Value="#00C8FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Click on Name/Time to Select -->
                                                <Button Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="Выбрать и показать фрагмент">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                                        <TextBlock Text=" (" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding FormattedRange}" FontSize="10.5" Foreground="{StaticResource AppLinkBrush}" FontFamily="Consolas"/>
                                                        <TextBlock Text=")" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Play Button -->
                                                <Button Command="{Binding DataContext.PlaySegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="▶" Width="18" Height="18" Margin="4,0,2,0" Background="Transparent" BorderThickness="0" Foreground="#00C8FF" FontSize="9" ToolTip="Воспроизвести фрагмент"/>

                                                <!-- Delete Button -->
                                                <Button Command="{Binding DataContext.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕" Width="16" Height="18" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="9" ToolTip="Удалить фрагмент"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Right: Multi-Segment Merge/Separate Radio Toggles & Clear -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <RadioButton Content="{DynamicResource TrimMergeSegments}" IsChecked="{Binding MergeSegmentsOnExport}" GroupName="SegmentExportMode" FontSize="10.5" Foreground="{StaticResource AppTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <RadioButton Content="{DynamicResource TrimSeparateSegments}" IsChecked="{Binding MergeSegmentsOnExport, Converter={StaticResource InverseBooleanConverter}}" GroupName="SegmentExportMode" FontSize="10.5" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Command="{Binding ClearSegmentsCommand}" Content="{DynamicResource TrimClearSegments}" Height="20" Padding="5,0" Background="Transparent" BorderThickness="0" Foreground="#E74C3C" FontSize="10" ToolTip="Очистить все фрагменты"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- BOTTOM CONTROLS & EXPORT PANEL -->
        <Border Grid.Row="3" Margin="10,0,10,6" Background="#15171C" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Exact Millisecond Input Boxes -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource TrimInPoint}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding InPointText, UpdateSourceTrigger=LostFocus}" Width="100" Height="24" FontFamily="Consolas, Courier New" FontSize="11" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{DynamicResource TrimOutPoint}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding OutPointText, UpdateSourceTrigger=LostFocus}" Width="100" Height="24" FontFamily="Consolas, Courier New" FontSize="11" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="{DynamicResource TrimDuration}" FontSize="11" Foreground="{StaticResource AppLinkBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedDurationText, Mode=OneWay}" Width="100" Height="24" FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppLinkBrush}" TextAlignment="Center" IsReadOnly="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Preset Selection -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0">
                    <TextBlock Text="{DynamicResource TrimPreset}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding AvailablePresets}" SelectedItem="{Binding SelectedPreset}" Height="26" IsEnabled="{Binding IsLosslessCopy, Converter={StaticResource InverseBooleanConverter}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Content="{DynamicResource TrimLossless}" IsChecked="{Binding IsLosslessCopy}" Margin="0,6,0,0" Foreground="{StaticResource AppTextBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddToQueueCommand}" Content="{Binding QueueButtonText}" Height="34" Padding="14,0" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <Button Command="{Binding RenderNowCommand}" Content="{Binding RenderButtonText}" Height="34" Padding="16,0" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER: HOTKEYS BAR -->
        <Border Grid.Row="4" Background="{StaticResource AppBackgroundSecondaryBrush}" Padding="10,0">
            <TextBlock Text="{DynamicResource TrimHotkeysHelp}" FontSize="10.5" Foreground="{StaticResource AppTextSecondaryBrush}" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
