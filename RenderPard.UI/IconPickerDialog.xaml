<Window x:Class="RenderPard.UI.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource IconPickerTitle}" Height="450" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource AppBackgroundBrush}"
        Style="{StaticResource AnipardWindowStyle}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="{DynamicResource IconPickerTitle}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="BtnCancel_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <ScrollViewer Grid.Row="1" Margin="10,10,5,5" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <ListBox x:Name="IconsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="56" Height="62" Margin="2" CornerRadius="6" Background="#1E2026" BorderBrush="#2D3038" BorderThickness="1" ToolTip="{Binding Name}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Background="#2C2F38" CornerRadius="4" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Image}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="8.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,3,2,0" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        
        <Border Grid.Row="2" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button Content="{DynamicResource BtnBrowseFile}" Width="90" Margin="0,0,10,0" Height="28" Click="BtnBrowse_Click"/>
                <Button Content="{DynamicResource BtnCancel}" Width="80" Margin="0,0,10,0" Click="BtnCancel_Click" Height="28"/>
                <Button Content="{DynamicResource BtnOk}" Width="80" Click="BtnOK_Click" Height="28" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
