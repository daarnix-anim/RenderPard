<Window x:Class="RenderPard.UI.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UpdateDialogTitle}" Height="490" Width="540" 
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" MinWidth="460" MinHeight="400"
        Background="{StaticResource AppBackgroundBrush}"
        Style="{StaticResource AnipardWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TitleIconText" Text="🚀" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleHeaderText" Text="{DynamicResource UpdateDialogHeader}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="BtnClose_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero: Version Info & Badge -->
            <Border Grid.Row="0" Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border x:Name="HeroIconBorder" Grid.Column="0" Width="44" Height="44" Background="#1F232B" CornerRadius="8" BorderBrush="#2D323E" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroIconText" Text="✨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Release Name & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ReleaseTitleText" Text="RenderPard v1.5.0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{DynamicResource UpdateInstalledVersion}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock x:Name="CurrentVersionText" Text="v1.4.0" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="  ➔  " FontSize="11" Foreground="{StaticResource AppLinkBrush}"/>
                            <TextBlock Text="{DynamicResource UpdateNewVersion}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock x:Name="NewVersionText" Text="v1.5.0" FontSize="11" Foreground="{StaticResource AppLinkBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badge -->
                    <Border x:Name="BadgeBorder" Grid.Column="2" Background="#26F39C12" CornerRadius="4" BorderBrush="#80F39C12" BorderThickness="1" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" Text="{DynamicResource UpdateBadgeNew}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppLinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- State 1: Changelog & Release Notes (Initial View) -->
            <Grid x:Name="NotesViewPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                    <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource UpdateWhatsNew}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppLinkBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Scrollable Changelog / Release Notes Box -->
                <Border Grid.Row="1" Background="#121418" CornerRadius="6" BorderBrush="#262A33" BorderThickness="1" Padding="12,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReleaseNotesTextBlock"
                                   TextWrapping="Wrap" 
                                   FontSize="12" 
                                   LineHeight="18" 
                                   Foreground="{StaticResource AppTextBrush}" 
                                   FontFamily="Segoe UI, Inter, Arial"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2" Text="{DynamicResource UpdateBackgroundHint}"
                           FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="2,8,2,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- State 2: Live Download Progress View -->
            <Grid x:Name="ProgressViewPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Progress Header -->
                <TextBlock x:Name="ProgressStateTitle" Grid.Row="0" Text="Загрузка обновления..." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Margin="2,10,0,12"/>

                <!-- Progress Bar Card -->
                <Border Grid.Row="1" Background="#121418" CornerRadius="8" BorderBrush="#282D37" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <!-- Sleek Custom Progress Bar -->
                        <Border Height="10" Background="#1B1F27" CornerRadius="5" ClipToBounds="True">
                            <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="1" Value="0" Height="10" 
                                         BorderThickness="0" Background="Transparent" Foreground="{StaticResource AppLinkBrush}"/>
                        </Border>

                        <!-- Progress Info Grid -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Downloaded / Total & Percent -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock x:Name="ProgressPercentText" Text="0%" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AppLinkBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ProgressBytesText" Text="0.0 / 0.0 МБ" FontSize="12" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Speed & ETA -->
                            <TextBlock x:Name="ProgressSpeedText" Grid.Column="1" Text="Подготовка к загрузке..." FontSize="11.5" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status / Error message banner -->
                <Border x:Name="StatusCardBorder" Grid.Row="2" Background="#171A21" CornerRadius="6" BorderBrush="#282D37" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusCardText" Text="Идет загрузка установочного пакета RenderPard..." FontSize="11.5" Foreground="{StaticResource AppTextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer Action Buttons -->
        <Border Grid.Row="2" Background="{StaticResource AppBackgroundSecondaryBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource AppBorderBrush}">
            <Grid Margin="16,0">
                <!-- Left: GitHub Web Link or Cancel -->
                <Button x:Name="BtnGitHub" Content="{DynamicResource UpdateBtnGithub}" Click="BtnGitHub_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Height="28" Padding="10,0" Background="Transparent" Foreground="{StaticResource AppTextSecondaryBrush}" ToolTip="Открыть страницу релиза в браузере"/>
                <Button x:Name="BtnCancelDownload" Content="{DynamicResource UpdateBtnCancel}" Click="BtnCancelDownload_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Height="28" Padding="12,0" Background="Transparent" Foreground="#E74C3C" BorderThickness="1" BorderBrush="#80E74C3C" Visibility="Collapsed"/>

                <!-- Right: Action Buttons Group -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Notes Mode Buttons -->
                    <StackPanel x:Name="NotesButtonsPanel" Orientation="Horizontal">
                        <Button Content="{DynamicResource UpdateBtnLater}" Width="130" Height="32" Margin="0,0,10,0" Click="BtnLater_Click"/>
                        <Button x:Name="BtnStartDownload" Content="{DynamicResource UpdateBtnDownload}" Width="160" Height="32" Click="BtnStartDownload_Click" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Downloading Mode Buttons -->
                    <StackPanel x:Name="DownloadingButtonsPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="BtnMinimizeToBackground" Content="{DynamicResource UpdateBtnBackground}" Width="160" Height="32" Click="BtnMinimizeToBackground_Click" Background="#232731" Foreground="{StaticResource AppTextBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Ready Mode Buttons -->
                    <StackPanel x:Name="ReadyButtonsPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="{DynamicResource UpdateBtnLater}" Width="130" Height="32" Margin="0,0,10,0" Click="BtnLater_Click"/>
                        <Button x:Name="BtnRestartNow" Content="{DynamicResource UpdateBtnRestart}" Width="210" Height="32" Click="BtnRestartNow_Click" Background="#2ECC71" Foreground="#0E2314" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Error Mode Buttons -->
                    <StackPanel x:Name="ErrorButtonsPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="{DynamicResource UpdateBtnCancel}" Width="100" Height="32" Margin="0,0,10,0" Click="BtnClose_Click"/>
                        <Button x:Name="BtnRetryDownload" Content="{DynamicResource UpdateBtnRetry}" Width="150" Height="32" Click="BtnRetryDownload_Click" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
