<Window x:Class="RenderPard.UI.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступно обновление" Height="480" Width="530" 
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" MinWidth="450" MinHeight="380"
        Background="{StaticResource AppBackgroundBrush}"
        Style="{StaticResource AnipardWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🚀" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Доступно обновление RenderPard" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="BtnLater_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hero: Version Info & Badge -->
            <Border Grid.Row="0" Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0" Width="42" Height="42" Background="#1F232B" CornerRadius="8" BorderBrush="#2D323E" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Release Name & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ReleaseTitleText" Text="RenderPard v1.5.5" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="Установлено: " FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock x:Name="CurrentVersionText" Text="v1.5.0" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="  ➔  " FontSize="11" Foreground="{StaticResource AppLinkBrush}"/>
                            <TextBlock Text="Новая версия: " FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                            <TextBlock x:Name="NewVersionText" Text="v1.5.5" FontSize="11" Foreground="{StaticResource AppLinkBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Badge -->
                    <Border Grid.Column="2" Background="#26F39C12" CornerRadius="4" BorderBrush="#80F39C12" BorderThickness="1" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="НОВЫЙ РЕЛИЗ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppLinkBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Changelog Header -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,6">
                <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Что нового в этой версии:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppLinkBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Scrollable Changelog / Release Notes Box -->
            <Border Grid.Row="2" Background="#121418" CornerRadius="6" BorderBrush="#262A33" BorderThickness="1" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ReleaseNotesTextBlock"
                               TextWrapping="Wrap" 
                               FontSize="12" 
                               LineHeight="18" 
                               Foreground="{StaticResource AppTextBrush}" 
                               FontFamily="Segoe UI, Inter, Arial"/>
                </ScrollViewer>
            </Border>

            <!-- Subtitle info -->
            <TextBlock Grid.Row="3" Text="Обновление будет скачано в фоне. Вы сможете применить его в любой удобный момент."
                       FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="2,8,2,0" TextWrapping="Wrap"/>
        </Grid>

        <!-- Footer Action Buttons -->
        <Border Grid.Row="2" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <Grid Margin="16,0">
                <!-- Left: GitHub Web Link -->
                <Button x:Name="BtnGitHub" Content="Открыть на GitHub ↗" Click="BtnGitHub_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Height="28" Padding="10,0" Background="Transparent" Foreground="{StaticResource AppTextSecondaryBrush}" ToolTip="Открыть страницу релиза в браузере"/>

                <!-- Right: Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Напомнить позже" Width="130" Height="30" Margin="0,0,10,0" Click="BtnLater_Click"/>
                    <Button x:Name="BtnDownload" Content="Скачать в фоне" Width="145" Height="30" Click="BtnDownload_Click" Background="{StaticResource AppLinkBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
