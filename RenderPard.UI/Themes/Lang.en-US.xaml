<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- MainWindow -->
    <system:String x:Key="AppTitle">RenderPard Queue</system:String>
    <system:String x:Key="MenuSettings">Settings</system:String>
    <system:String x:Key="DropFilesHere">Drop video files here...</system:String>
    <system:String x:Key="RegisterMenu">Register Context Menu</system:String>
    <system:String x:Key="RemoveMenu">Remove Menu</system:String>
    <system:String x:Key="ClearCompleted">Clear Completed/Pending</system:String>
    <system:String x:Key="DownloadFfmpeg">Download FFmpeg</system:String>
    <system:String x:Key="DownloadingFfmpeg">Downloading FFmpeg...</system:String>
    
    <!-- DataGrid Columns -->
    <system:String x:Key="ColFile">File</system:String>
    <system:String x:Key="ColPreset">Preset</system:String>
    <system:String x:Key="ColStatus">Status</system:String>
    <system:String x:Key="ColAction">Action</system:String>

    <!-- Settings Window -->
    <system:String x:Key="SettingsTitle">RenderPard Settings</system:String>
    <system:String x:Key="PresetsHeader">Presets</system:String>
    <system:String x:Key="AddPreset">Add Preset</system:String>
    <system:String x:Key="RemovePreset">Remove</system:String>
    <system:String x:Key="SaveClose">Save &amp; Close</system:String>

    <!-- General Tab -->
    <system:String x:Key="TabGeneral">Basic Settings</system:String>
    <system:String x:Key="OpenFolderOnCompletion">Open folder when queue is completed</system:String>
    <system:String x:Key="MinimizeToTrayOnClose">Minimize to tray on close (X button)</system:String>
    <system:String x:Key="LanguageLabel">Language (Язык):</system:String>
    <system:String x:Key="LanguageWarning">Some changes will take effect after restart.</system:String>

    <!-- Video Tab -->
    <system:String x:Key="TabVideo">Video</system:String>
    <system:String x:Key="ContainerFormat">Format (Container):</system:String>
    <system:String x:Key="VideoCodec">Video Codec:</system:String>
    <system:String x:Key="TargetBitrate">Target Bitrate (kbps):</system:String>
    <system:String x:Key="MaxLongSide">Max Long Side Size:</system:String>
    <system:String x:Key="AutoCalcBitrate">Auto-calc bitrate for target size (MB):</system:String>
    <system:String x:Key="ExtractAlphaMask">Extract alpha channel to video + mask (_mask.mp4)</system:String>
    <system:String x:Key="PresetName">Name:</system:String>
    <system:String x:Key="ShowInMenu">Show in Windows context menu</system:String>
    <system:String x:Key="GifFps">Framerate (FPS):</system:String>

    <!-- Audio Tab -->
    <system:String x:Key="TabAudio">Audio</system:String>
    <system:String x:Key="AudioMode">Audio Mode:</system:String>
    <system:String x:Key="AudioCodec">Audio Codec:</system:String>
    <system:String x:Key="AudioBitrate">Audio Bitrate (kbps):</system:String>

    <!-- Watermark Tab -->
    <system:String x:Key="TabWatermark">Watermark</system:String>
    <system:String x:Key="EnableWatermark">Enable Watermark</system:String>
    <system:String x:Key="WmText">Text:</system:String>
    <system:String x:Key="WmFontSize">Font Size:</system:String>
    <system:String x:Key="WmColor">Color (Hex):</system:String>
    <system:String x:Key="WmPosition">Position:</system:String>
    <system:String x:Key="WmOpacity">Opacity:</system:String>

    <!-- Timecode Tab -->
    <system:String x:Key="TabTimecode">Timecode</system:String>
    <system:String x:Key="EnableTimecode">Enable Timecode</system:String>
    
</ResourceDictionary>
