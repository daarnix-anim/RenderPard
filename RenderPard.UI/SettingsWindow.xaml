<Window x:Class="RenderPard.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewModels="clr-namespace:RenderPard.UI.ViewModels"
        xmlns:models="clr-namespace:RenderPard.Core.Models;assembly=RenderPard.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="RenderPard Settings" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Name="SettingsWin"
        Style="{StaticResource AnipardWindowStyle}">
    
    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <local:MaxLongSideVisibilityConverter x:Key="MaxLongSideVisibilityConverter"/>
        <local:VideoSettingsVisibilityConverter x:Key="VideoSettingsVisibilityConverter"/>
        <local:GifVisibilityConverter x:Key="GifVisibilityConverter"/>
        <local:IconNameToImageSourceConverter x:Key="IconNameToImageSourceConverter"/>
        <local:ImageSettingsVisibilityConverter x:Key="ImageSettingsVisibilityConverter"/>
        <local:NamingModeConverter x:Key="NamingModeConverter"/>
        <local:NumberingModeConverter x:Key="NumberingModeConverter"/>
        <local:InverseBooleanToBooleanConverter x:Key="InverseBooleanToBooleanConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="RenderPard Settings" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Click="Minimize_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left pane: Preset list -->
            <Border Grid.Column="0" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource PresetsHeader}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTextBrush}"/>
                    
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column: Video Presets -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Add Video Preset Button -->
                            <Button Grid.Row="0" Command="{Binding AddVideoPresetCommand}" Height="35" ToolTip="{DynamicResource AddPreset}" Padding="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M18,4l2,4h-3l-2-4h-2l2,4h-3l-2-4H8l2,4H7L5,4H4c-1.1,0-1.99,0.9-1.99,2L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V4H18z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Add Video" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <ListBox Grid.Row="2" ItemsSource="{Binding VideoPresets}" SelectedItem="{Binding SelectedPreset}" 
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Border x:Name="SelectBorder" Background="#22ffffff" CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter TargetName="Border" Property="Background" Value="#08ffffff"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SelectBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SelectBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding ShowInContextMenu}" ToolTip="{DynamicResource ShowInMenu}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        
                        <!-- Right Column: Photo Presets -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Add Photo Preset Button -->
                            <Button Grid.Row="0" Command="{Binding AddImagePresetCommand}" Height="35" ToolTip="{DynamicResource AddPreset}" Padding="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M21,19V5c0-1.1-0.9-2-2-2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14C20.1,21,21,20.1,21,19z M8.5,13.5l2.5,3.01L14.5,12l4.5,6H5L8.5,13.5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Add Photo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <ListBox Grid.Row="2" ItemsSource="{Binding ImagePresets}" SelectedItem="{Binding SelectedPreset}" 
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="5,3"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Border x:Name="SelectBorder" Background="#22ffffff" CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter TargetName="Border" Property="Background" Value="#08ffffff"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SelectBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SelectBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding ShowInContextMenu}" ToolTip="{DynamicResource ShowInMenu}" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                    
                    <!-- Delete Preset Button (Moved to bottom) -->
                    <StackPanel Grid.Row="4" HorizontalAlignment="Left" Margin="0,15,0,0">
                        <Button Content="Delete Selected Preset" Command="{Binding DeletePresetCommand}" Height="26" FontSize="11" 
                                Foreground="{StaticResource AppTextSecondaryBrush}" BorderThickness="0" Background="Transparent" Padding="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right pane: Preset properties -->
            <Border Grid.Column="2" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}" IsEnabled="{Binding SelectedPreset, Converter={StaticResource IsNotNullConverter}}">
                <TabControl DataContext="{Binding SelectedPreset}">
                    <TabControl.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
                        </Style>
                    </TabControl.Resources>
                    <!-- GENERAL & VIDEO (COMBINED) TAB -->
                    <TabItem Header="{DynamicResource TabGeneral}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Name and Icon -->
                                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource PresetName}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <ComboBox Width="110" SelectedItem="{Binding NamingLogic}">
                                            <ComboBox.ItemsSource>
                                                <Binding Source="{local:EnumBindingSource {x:Type models:NamingMode}}" />
                                            </ComboBox.ItemsSource>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource NamingModeConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <TextBlock Text="Нумерация:" Margin="15,0,4,0" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Width="110" SelectedItem="{Binding NumberingLogic}" ToolTip="Добавляет порядковый номер к имени файла (например, _1, _2)">
                                            <ComboBox.ItemsSource>
                                                <Binding Source="{local:EnumBindingSource {x:Type models:NamingMode}}" />
                                            </ComboBox.ItemsSource>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource NumberingModeConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <Button Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="24" Height="24" Margin="15,0,0,0" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Cursor="Hand" Padding="2" ToolTip="Выбор иконки">
                                            <Image Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Container Format -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource ContainerFormat}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Container}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:ContainerFormat}}}"/>

                                <!-- Video Codec (Hidden if GIF) -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoCodec}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding Container, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding VideoCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:VideoCodec}}}" Visibility="{Binding Container, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>

                                <!-- Target Bitrate (Hidden if GIF) -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource TargetBitrate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding Container, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TargetVideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Container, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>

                                <!-- Max Long Side -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Длинная сторона, px" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding Converter={StaticResource MaxLongSideVisibilityConverter}}"/>
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Converter={StaticResource MaxLongSideVisibilityConverter}}">
                                    <TextBox Text="{Binding MaxLongSideSize, UpdateSourceTrigger=PropertyChanged}" Width="100" IsEnabled="{Binding KeepOriginalResolution, Converter={StaticResource InverseBooleanToBooleanConverter}}"/>
                                    <CheckBox IsChecked="{Binding KeepOriginalResolution}" Margin="15,0,0,0" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center" ToolTip="Оставить разрешение исходника"/>
                                </StackPanel>

                                <!-- Auto Calc Bitrate (Hidden if GIF) -->
                                <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Visibility="{Binding Container, Converter={StaticResource VideoSettingsVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Content="Включить аудио" IsChecked="{Binding IncludeAudio}" Foreground="{StaticResource AppTextBrush}" ToolTip="Вшить или перекодировать аудиодорожку в финальное видео"/>
                                        <CheckBox Content="Оставить оригинальную аудиодорожку" IsChecked="{Binding CopyAudio}" Margin="15,0,0,0" Foreground="{StaticResource AppTextBrush}" IsEnabled="{Binding IncludeAudio}" ToolTip="Копировать аудиодорожку без изменений для сохранения оригинального качества"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Content="{DynamicResource AutoCalcBitrate}" IsChecked="{Binding UseWebPreLogic}" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center" ToolTip="Автоматически рассчитать битрейт для достижения заданного целевого размера файла (МБ)"/>
                                        <TextBox Text="{Binding MaxSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,0,0" IsEnabled="{Binding UseWebPreLogic}"/>
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource ExtractAlphaMask}" IsChecked="{Binding ExtractAlphaMask}" Foreground="{StaticResource AppTextBrush}" ToolTip="Сохранить альфа-канал отдельным черно-белым видеофайлом-маской (_mask.mp4)"/>
                                </StackPanel>

                                <!-- GIF FPS (Visible only if GIF) -->
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="{DynamicResource GifFps}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding Container, Converter={StaticResource GifVisibilityConverter}}"/>
                                <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Container, Converter={StaticResource GifVisibilityConverter}}">
                                    <TextBox Text="{Binding GifFps, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                    <TextBlock Text=" fps" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- IMAGE QUALITY -->
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="{DynamicResource ImageQuality}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                                <Grid Grid.Row="16" Grid.Column="1" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Value="{Binding ImageQuality}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ImageQuality}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- IMAGE RESIZE MODE -->
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="{DynamicResource ImageResizeMode}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                                <ComboBox Grid.Row="18" Grid.Column="1" SelectedItem="{Binding ImageResizeMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:ResizeMode}}}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>

                                <!-- IMAGE RESIZE VALUE -->
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="{DynamicResource ImageResizeValue}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                                <TextBox Grid.Row="20" Grid.Column="1" Text="{Binding ImageResizeValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WATERMARK TAB -->
                    <TabItem Header="{DynamicResource TabWatermark}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="{DynamicResource EnableWatermark}" IsChecked="{Binding HasWatermark}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20" ToolTip="Наложить водяной знак (логотип) на видео"/>
                                
                                <Grid DataContext="{Binding Watermark}" IsEnabled="{Binding DataContext.HasWatermark, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WmText}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WmFontSize}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WmColor}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WmPosition}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource WmOpacity}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="8" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- TIMECODE TAB -->
                    <TabItem Header="{DynamicResource TabTimecode}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="{DynamicResource EnableTimecode}" IsChecked="{Binding HasTimecode}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20" ToolTip="Наложить таймкод (счетчик времени) на видео"/>
                                
                                <Grid DataContext="{Binding TimecodeStyles[0]}" IsEnabled="{Binding DataContext.HasTimecode, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WmFontSize}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WmColor}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WmPosition}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WmOpacity}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="6" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Bottom Buttons & Settings -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Command="{Binding OpenGlobalSettingsCommand}" ToolTip="Общие настройки" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,0,0" HorizontalAlignment="Left" Padding="0">
