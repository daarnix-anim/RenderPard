                        </Canvas>
                    </Viewbox>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="100" Height="26" Margin="0,0,10,0"/>
                    <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="120" Height="26" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>


