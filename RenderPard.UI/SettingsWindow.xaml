<Window x:Class="RenderPard.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewModels="clr-namespace:RenderPard.UI.ViewModels"
        xmlns:models="clr-namespace:RenderPard.Core.Models;assembly=RenderPard.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="RenderPard Settings" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Name="SettingsWin"
        Style="{StaticResource AnipardWindowStyle}">
    
    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="RenderPard Settings" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Click="Minimize_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left pane: Preset list -->
            <Border Grid.Column="0" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="15" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Presets" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTextBrush}"/>
                    
                    <ListBox Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextBrush}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AppLinkBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Add" Command="{Binding AddPresetCommand}" Height="35"/>
                        <Button Grid.Column="2" Content="Delete" Command="{Binding DeletePresetCommand}" Height="35"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right pane: Preset properties -->
            <Border Grid.Column="2" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}" IsEnabled="{Binding SelectedPreset, Converter={StaticResource IsNotNullConverter}}">
                <TabControl DataContext="{Binding SelectedPreset}">
                    <!-- GENERAL TAB -->
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <CheckBox Content="Show in Context Menu" IsChecked="{Binding ShowInContextMenu}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,25"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- VIDEO TAB -->
                    <TabItem Header="Video">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Video Codec:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding VideoCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:VideoCodec}}}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Bitrate (kbps):" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetVideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Long Side Size:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxLongSideSize, UpdateSourceTrigger=PropertyChanged}"/>

                                <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Use Web_pre Logic (Auto-calculate bitrate for ~18MB)" IsChecked="{Binding UseWebPreLogic}" Foreground="{StaticResource AppTextBrush}"/>
                                
                                <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Extract Alpha Mask as a separate file (e.g. _mask.mp4)" IsChecked="{Binding ExtractAlphaMask}" Foreground="{StaticResource AppTextBrush}"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- AUDIO TAB -->
                    <TabItem Header="Audio">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Audio Mode:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding AudioMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioMode}}}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Audio Codec:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding AudioCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioCodec}}}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Audio Bitrate (kbps):" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AudioBitrateKbps, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WATERMARK TAB -->
                    <TabItem Header="Watermark">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="Enable Watermark" IsChecked="{Binding HasWatermark}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                                
                                <Grid DataContext="{Binding Watermark}" IsEnabled="{Binding DataContext.HasWatermark, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Text:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Font Size:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Color (Hex):" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Position:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Opacity:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="8" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- TIMECODE TAB -->
                    <TabItem Header="Timecode">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="Enable Timecode" IsChecked="{Binding HasTimecode}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                                
                                <Grid DataContext="{Binding TimecodeStyles[0]}" IsEnabled="{Binding DataContext.HasTimecode, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Font Size:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Color (Hex):" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Position:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Opacity:" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="6" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Bottom Buttons -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="120" Height="40" Margin="0,0,15,0"/>
                <Button Content="Save &amp; Apply" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="150" Height="40" Background="{StaticResource AppButtonHoverBrush}" Foreground="{StaticResource AppBackgroundBrush}" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
