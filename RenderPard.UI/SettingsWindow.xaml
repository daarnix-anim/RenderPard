<Window x:Class="RenderPard.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewModels="clr-namespace:RenderPard.UI.ViewModels"
        xmlns:models="clr-namespace:RenderPard.Core.Models;assembly=RenderPard.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="RenderPard Settings" Height="600" Width="850"
        WindowStartupLocation="CenterOwner"
        Name="SettingsWin"
        Style="{StaticResource AnipardWindowStyle}">
    
    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="RenderPard Settings" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Click="Minimize_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left pane: Preset list -->
            <Border Grid.Column="0" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="15" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource PresetsHeader}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTextBrush}"/>
                    
                    <ListBox Grid.Row="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextBrush}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="HoverOverlay" Background="#15FFFFFF" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
                                                <Border x:Name="SelectBorder" Background="#1AF39C12" BorderBrush="{StaticResource AppLinkBrush}" BorderThickness="1" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
                                                <Border Background="Transparent" CornerRadius="6">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SelectBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SelectBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowInContextMenu}" ToolTip="{DynamicResource ShowInMenu}" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource AddPreset}" Command="{Binding AddPresetCommand}" Height="35"/>
                        <Button Grid.Column="2" Content="Delete" Command="{Binding DeletePresetCommand}" Height="35"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right pane: Preset properties -->
            <Border Grid.Column="2" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="20" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}" IsEnabled="{Binding SelectedPreset, Converter={StaticResource IsNotNullConverter}}">
                <TabControl DataContext="{Binding SelectedPreset}">
                    <!-- GENERAL TAB -->
                    <TabItem Header="{DynamicResource TabGeneral}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource PresetName}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- VIDEO TAB -->
                    <TabItem Header="{DynamicResource TabVideo}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource VideoCodec}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding VideoCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:VideoCodec}}}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource TargetBitrate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetVideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource MaxLongSide}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxLongSideSize, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <CheckBox Content="{DynamicResource AutoCalcBitrate}" IsChecked="{Binding UseWebPreLogic}" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding MaxSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,0,0" IsEnabled="{Binding UseWebPreLogic}"/>
                                </StackPanel>
                                
                                <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="{DynamicResource ExtractAlphaMask}" IsChecked="{Binding ExtractAlphaMask}" Foreground="{StaticResource AppTextBrush}"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- AUDIO TAB -->
                    <TabItem Header="{DynamicResource TabAudio}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AudioMode}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding AudioMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioMode}}}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource AudioCodec}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding AudioCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioCodec}}}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource AudioBitrate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding AudioBitrateKbps, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WATERMARK TAB -->
                    <TabItem Header="{DynamicResource TabWatermark}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="{DynamicResource EnableWatermark}" IsChecked="{Binding HasWatermark}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                                
                                <Grid DataContext="{Binding Watermark}" IsEnabled="{Binding DataContext.HasWatermark, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WmText}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WmFontSize}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WmColor}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WmPosition}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource WmOpacity}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="8" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- TIMECODE TAB -->
                    <TabItem Header="{DynamicResource TabTimecode}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="{DynamicResource EnableTimecode}" IsChecked="{Binding HasTimecode}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                                
                                <Grid DataContext="{Binding TimecodeStyles[0]}" IsEnabled="{Binding DataContext.HasTimecode, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="15"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WmFontSize}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WmColor}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WmPosition}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WmOpacity}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="6" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Bottom Buttons & Settings -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Command="{Binding OpenGlobalSettingsCommand}" ToolTip="Global Settings" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Fill="{StaticResource AppTextBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="120" Height="40" Margin="0,0,15,0"/>
                    <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="150" Height="40" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

