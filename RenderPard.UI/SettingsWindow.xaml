<Window x:Class="RenderPard.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewModels="clr-namespace:RenderPard.UI.ViewModels"
        xmlns:models="clr-namespace:RenderPard.Core.Models;assembly=RenderPard.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{DynamicResource SettingsTitle}" Height="620" Width="880"
        WindowStartupLocation="CenterOwner"
        Name="SettingsWin"
        Style="{StaticResource AnipardWindowStyle}">
    
    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <local:MaxLongSideVisibilityConverter x:Key="MaxLongSideVisibilityConverter"/>
        <local:VideoSettingsVisibilityConverter x:Key="VideoSettingsVisibilityConverter"/>
        <local:AudioSettingsVisibilityConverter x:Key="AudioSettingsVisibilityConverter"/>
        <local:GifVisibilityConverter x:Key="GifVisibilityConverter"/>
        <local:IconNameToImageSourceConverter x:Key="IconNameToImageSourceConverter"/>
        <local:ImageSettingsVisibilityConverter x:Key="ImageSettingsVisibilityConverter"/>
        <local:AudioEncodeSettingsVisibilityConverter x:Key="AudioEncodeSettingsVisibilityConverter"/>
        <local:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="{DynamicResource SettingsTitle}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Click="Minimize_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left pane: Preset list -->
            <Border Grid.Column="0" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/> <!-- Tabs -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>    <!-- ListBox -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{DynamicResource PresetsHeader}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AppTextBrush}"/>
                    
                    <!-- Tabs (Video / Photo / Audio) -->
                    <Border Grid.Row="2" Background="#0E0F12" CornerRadius="6" Padding="2" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <RadioButton Grid.Column="0" Content="{DynamicResource PresetsTabVideo}" IsChecked="{Binding IsVideoTabSelected}" Margin="0,0,1,0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,5">
                                                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#1AFFFFFF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AppBackgroundSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            
                            <RadioButton Grid.Column="1" Content="{DynamicResource PresetsTabPhoto}" IsChecked="{Binding IsPhotoTabSelected}" Margin="1,0,1,0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,5">
                                                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#1AFFFFFF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AppBackgroundSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton Grid.Column="2" Content="{DynamicResource PresetsTabAudio}" IsChecked="{Binding IsAudioTabSelected}" Margin="1,0,0,0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,5">
                                                        <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#1AFFFFFF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AppBackgroundSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- Preset List -->
                    <ListBox Grid.Row="4" ItemsSource="{Binding FilteredPresetsView}" SelectedItem="{Binding SelectedPreset}" 
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="PresetsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PresetsListBox_PreviewMouseMove"
                             DragOver="PresetsListBox_DragOver"
                             DragLeave="PresetsListBox_DragLeave"
                             Drop="PresetsListBox_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Drop Insertion Indicators -->
                                                <Border x:Name="TopDropIndicator" Height="2" Background="{StaticResource AppLinkBrush}" VerticalAlignment="Top" Margin="2,-2,2,0" CornerRadius="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                                                <Border x:Name="BottomDropIndicator" Height="2" Background="{StaticResource AppLinkBrush}" VerticalAlignment="Bottom" Margin="2,0,2,-2" CornerRadius="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2C303A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#322A5C"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AppLinkBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Drag Grip Handle -->
                                    <Viewbox Grid.Column="0" Width="8" Height="14" Stretch="Uniform" Margin="0,0,6,0" Opacity="0.35" Cursor="SizeAll" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{StaticResource AppTextSecondaryBrush}" Data="M9,3 C10.1,3 11,3.9 11,5 C11,6.1 10.1,7 9,7 C7.9,7 7,6.1 7,5 C7,3.9 7.9,3 9,3 Z M9,10 C10.1,10 11,10.9 11,12 C11,13.1 10.1,14 9,14 C7.9,14 7,13.1 7,12 C7,10.9 7.9,10 9,10 Z M9,17 C10.1,17 11,17.9 11,19 C11,20.1 10.1,21 9,21 C7.9,21 7,20.1 7,19 C7,17.9 7.9,17 9,17 Z M15,3 C16.1,3 17,3.9 17,5 C17,6.1 16.1,7 15,7 C13.9,7 13,6.1 13,5 C13,3.9 13.9,3 15,3 Z M15,10 C16.1,10 17,10.9 17,12 C17,13.1 16.1,14 15,14 C13.9,14 13,13.1 13,12 C13,10.9 13.9,10 15,10 Z M15,17 C16.1,17 17,17.9 17,19 C17,20.1 16.1,21 15,21 C13.9,21 13,20.1 13,19 C13,17.9 13.9,17 15,17 Z"/>
                                        </Canvas>
                                    </Viewbox>

                                    <!-- Icon (Left) -->
                                    <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="4" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Preset Name (Center, fills space) -->
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                    
                                    <!-- Context Menu Checkbox (Right) -->
                                    <CheckBox Grid.Column="3" IsChecked="{Binding ShowInContextMenu}" ToolTip="{DynamicResource ShowInMenu}" Margin="8,0,2,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Actions (Ghost Carbon Style) -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Command="{Binding AddPresetCommand}" Height="28" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="+" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                                                        <TextBlock Text="{DynamicResource AddPreset}" VerticalAlignment="Center" FontSize="11" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1AFFFFFF"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#3C404B"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button Grid.Column="2" Command="{Binding DeletePresetCommand}" Height="28" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="✕" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="10" Foreground="{TemplateBinding Foreground}"/>
                                                        <TextBlock Text="{DynamicResource RemovePreset}" VerticalAlignment="Center" FontSize="11" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#1AEB5757"/>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4DEB5757"/>
                                                        <Setter Property="Foreground" Value="#EB5757"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#33EB5757"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right pane: Preset properties -->
            <Border Grid.Column="2" Grid.Row="0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="8" Background="{StaticResource AppBackgroundSecondaryBrush}" IsEnabled="{Binding SelectedPreset, Converter={StaticResource IsNotNullConverter}}">
                <TabControl DataContext="{Binding SelectedPreset}">
                    <TabControl.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
                        </Style>
                    </TabControl.Resources>
                    
                    <!-- GENERAL & VIDEO (COMBINED) TAB -->
                    <TabItem Header="{DynamicResource TabGeneral}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Name and Icon -->
                                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource PresetName}" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <ComboBox Width="130" SelectedItem="{Binding NamingLogic}">
                                            <ComboBox.ItemsSource>
                                                <Binding Source="{local:EnumBindingSource {x:Type models:NamingMode}}" />
                                            </ComboBox.ItemsSource>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <TextBlock Text="{DynamicResource NumberingLabel}" Margin="15,0,4,0" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Width="130" SelectedItem="{Binding NumberingLogic}" ToolTip="{DynamicResource NumberingTooltip}">
                                            <ComboBox.ItemsSource>
                                                <Binding Source="{local:EnumBindingSource {x:Type models:NamingMode}}" />
                                            </ComboBox.ItemsSource>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <Button Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Width="24" Height="24" Margin="15,0,0,0" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Cursor="Hand" Padding="2" ToolTip="{DynamicResource IconPickerTitle}">
                                            <Image Source="{Binding CustomIcon, Converter={StaticResource IconNameToImageSourceConverter}}" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Match Source Properties -->
                                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="{DynamicResource MatchSourceProperties}" IsChecked="{Binding MatchSourceProperties}" Foreground="{StaticResource AppTextBrush}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}" ToolTip="{DynamicResource MatchSourcePropertiesTooltip}" />
                                </Grid>

                                <!-- Container Format -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource ContainerFormat}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Container}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:ContainerFormat}}}" IsEnabled="{Binding MatchSourceProperties, Converter={StaticResource InverseBooleanConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Video Codec (Hidden if GIF or Image or Audio) -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource VideoCodec}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding VideoCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:VideoCodec}}}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}" IsEnabled="{Binding MatchSourceProperties, Converter={StaticResource InverseBooleanConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Target Bitrate (Hidden if GIF or Image or Audio) -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource TargetBitrate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TargetVideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}" IsEnabled="{Binding MatchSourceProperties, Converter={StaticResource InverseBooleanConverter}}"/>

                                <!-- Max Long Side -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource MaxLongSidePx}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding Converter={StaticResource MaxLongSideVisibilityConverter}}"/>
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Converter={StaticResource MaxLongSideVisibilityConverter}}">
                                    <TextBox Text="{Binding MaxLongSideSize, UpdateSourceTrigger=PropertyChanged}" Width="100" IsEnabled="{Binding KeepOriginalResolution, Converter={StaticResource InverseBooleanConverter}}"/>
                                    <CheckBox IsChecked="{Binding KeepOriginalResolution}" Margin="15,0,0,0" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center" ToolTip="{DynamicResource KeepOriginalResolution}"/>
                                </StackPanel>

                                <!-- Audio Mode Selection (for Video Presets) -->
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="{DynamicResource AudioMode}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}"/>
                                <ComboBox Grid.Row="10" Grid.Column="1" SelectedItem="{Binding AudioMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioMode}}}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Audio Encode Detailed Parameters (Visible only when AudioMode == Encode for Video Presets) -->
                                <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Visibility="{Binding AudioMode, Converter={StaticResource AudioEncodeSettingsVisibilityConverter}}">
                                    <Grid Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Audio Codec -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AudioCodec}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding AudioCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioCodec}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Audio Bitrate -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource AudioBitrate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Text="{Binding AudioBitrateKbps, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            <TextBlock Text=" kbps" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="5,0,0,0"/>
                                        </StackPanel>

                                        <!-- Audio Sample Rate -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource AudioSampleRate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding AudioSampleRate}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioSampleRate}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Audio Channels -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource AudioChannels}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding AudioChannels}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioChannels}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Normalize Audio Checkbox -->
                                        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="{DynamicResource AudioNormalizeWeb}" IsChecked="{Binding NormalizeAudio}" Foreground="{StaticResource AppTextBrush}" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <!-- ================= AUDIO PRESET DEDICATED SETTINGS ================= -->
                                <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Visibility="{Binding IsAudioPreset, Converter={StaticResource AudioSettingsVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Audio Codec -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AudioCodec}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding AudioCodec}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioCodec}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Audio Bitrate -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource AudioBitrate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Text="{Binding AudioBitrateKbps, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                            <TextBlock Text=" kbps" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="5,0,0,0"/>
                                        </StackPanel>

                                        <!-- Audio Sample Rate -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource AudioSampleRate}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding AudioSampleRate}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioSampleRate}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Audio Channels -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource AudioChannels}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                        <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding AudioChannels}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:AudioChannels}}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Normalize Audio Checkbox -->
                                        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="{DynamicResource AudioNormalizeWeb}" IsChecked="{Binding NormalizeAudio}" Foreground="{StaticResource AppTextBrush}" Margin="0,4,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Auto Calc Bitrate & Alpha Mask -->
                                <StackPanel Grid.Row="14" Grid.ColumnSpan="2" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Content="{DynamicResource AutoCalcBitrate}" IsChecked="{Binding UseWebPreLogic}" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding MaxSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,0,0" IsEnabled="{Binding UseWebPreLogic}"/>
                                    </StackPanel>
                                    <CheckBox Content="{DynamicResource ExtractAlphaMask}" IsChecked="{Binding ExtractAlphaMask}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource MaxDuration}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding MaxDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,0,0"/>
                                        <TextBlock Text="{DynamicResource MaxFps}" Foreground="{StaticResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        <TextBox Text="{Binding MaxFps, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- GIF FPS (Visible only if GIF) -->
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="{DynamicResource GifFps}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding Container, Converter={StaticResource GifVisibilityConverter}}"/>
                                <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Container, Converter={StaticResource GifVisibilityConverter}}">
                                    <TextBox Text="{Binding GifFps, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                    <TextBlock Text=" fps" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="5,0,0,0"/>
                                </StackPanel>

                                <!-- IMAGE QUALITY -->
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="{DynamicResource ImageQuality}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                                <Grid Grid.Row="18" Grid.Column="1" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Value="{Binding ImageQuality}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ImageQuality}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- IMAGE RESIZE MODE -->
                                <TextBlock Grid.Row="20" Grid.Column="0" Text="{DynamicResource ImageResizeMode}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                                <ComboBox Grid.Row="20" Grid.Column="1" SelectedItem="{Binding ImageResizeMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:ResizeMode}}}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- IMAGE RESIZE VALUE (Disabled when Original) -->
                                <TextBlock Grid.Row="22" Grid.Column="0" Text="{DynamicResource ImageResizeValue}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}"/>
                                <TextBox Grid.Row="22" Grid.Column="1" Text="{Binding ImageResizeValue, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsImagePreset, Converter={StaticResource ImageSettingsVisibilityConverter}}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ImageResizeMode}" Value="Original">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- WATERMARK TAB -->
                    <TabItem Header="{DynamicResource TabWatermark}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="{DynamicResource EnableWatermark}" IsChecked="{Binding HasWatermark}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                                
                                <Grid DataContext="{Binding Watermark}" IsEnabled="{Binding DataContext.HasWatermark, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WmText}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WmFontSize}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WmColor}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WmPosition}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource WmOpacity}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="8" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <!-- TIMECODE TAB -->
                    <TabItem Header="{DynamicResource TabTimecode}" Visibility="{Binding IsVideoPreset, Converter={StaticResource VideoSettingsVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,15,0,0">
                                <CheckBox Content="{DynamicResource EnableTimecode}" IsChecked="{Binding HasTimecode}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                                
                                <Grid DataContext="{Binding TimecodeStyles[0]}" IsEnabled="{Binding DataContext.HasTimecode, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource WmFontSize}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource WmColor}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource WmPosition}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Position}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:Position9}}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource WmOpacity}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                    <Grid Grid.Row="6" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Bottom Buttons & Settings -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Command="{Binding OpenGlobalSettingsCommand}" ToolTip="{DynamicResource GlobalSettingsTitle}" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0" HorizontalAlignment="Left" Padding="0">
                    <Viewbox Width="20" Height="20" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z" Fill="{StaticResource AppTextBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource BtnCancel}" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="100" Height="26" Margin="0,0,10,0"/>
                    <Button Content="{DynamicResource SaveClose}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=SettingsWin}" Width="110" Height="26" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
