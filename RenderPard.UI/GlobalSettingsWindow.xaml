<Window x:Class="RenderPard.UI.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewModels="clr-namespace:RenderPard.UI.ViewModels"
        mc:Ignorable="d"
        Title="Global Settings" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AnipardWindowStyle}">

    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="Global Settings" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Padding="20">
            <StackPanel>
                <CheckBox Content="{DynamicResource OpenFolderOnCompletion}" IsChecked="{Binding OpenFolderOnCompletion}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,15"/>
                <CheckBox Content="{DynamicResource MinimizeToTrayOnClose}" IsChecked="{Binding MinimizeToTrayOnClose}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,25"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Elegant Language Toggle (EN / RU) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource AppBackgroundSecondaryBrush}" Margin="0,0,15,0">
                        <Button Content="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US" Width="45" Height="26" BorderThickness="0" Cursor="Hand" FontWeight="Medium">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Language}" Value="en-US">
                                            <Setter Property="Background" Value="{StaticResource AppLinkBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="RU" Command="{Binding ChangeLanguageCommand}" CommandParameter="ru-RU" Width="45" Height="26" BorderThickness="0" Cursor="Hand" FontWeight="Medium">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Language}" Value="ru-RU">
                                            <Setter Property="Background" Value="{StaticResource AppLinkBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
