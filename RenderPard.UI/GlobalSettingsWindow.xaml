<Window x:Class="RenderPard.UI.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewModels="clr-namespace:RenderPard.UI.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource GlobalSettingsTitle}" Height="340" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AnipardWindowStyle}">

    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="{DynamicResource GlobalSettingsTitle}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Padding="20,18">
            <StackPanel>
                <CheckBox Content="{DynamicResource OpenFolderOnCompletion}" IsChecked="{Binding OpenFolderOnCompletion}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,14"/>
                <CheckBox Content="{DynamicResource MinimizeToTrayOnClose}" IsChecked="{Binding MinimizeToTrayOnClose}" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,20"/>
                
                <!-- Language Selector -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Elegant Language Toggle (EN / RU) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource AppBackgroundSecondaryBrush}" Margin="0,0,15,0">
                        <Button Content="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US" Width="45" Height="26" BorderThickness="0" Cursor="Hand" FontWeight="Medium">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Language}" Value="en-US">
                                            <Setter Property="Background" Value="{StaticResource AppLinkBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="RU" Command="{Binding ChangeLanguageCommand}" CommandParameter="ru-RU" Width="45" Height="26" BorderThickness="0" Cursor="Hand" FontWeight="Medium">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Language}" Value="ru-RU">
                                            <Setter Property="Background" Value="{StaticResource AppLinkBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12"/>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="0,16,0,16"/>

                <!-- App Updates Section -->
                <Border Background="#14171E" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Version Label -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource SettingsAppVersion}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AppVersion}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AppTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Check Updates Button -->
                            <Button Grid.Column="1" Command="{Binding CheckForUpdatesCommand}" Height="28" Padding="12,0" 
                                    Background="{StaticResource AppBackgroundSecondaryBrush}" Foreground="{StaticResource AppTextBrush}" 
                                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔄 " FontSize="10.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource SettingsCheckUpdates}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Status text -->
                        <TextBlock Text="{Binding UpdateCheckStatusText}" FontSize="11" Foreground="{StaticResource AppLinkBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding UpdateCheckStatusText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
