<Window x:Class="RenderPard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" Height="450" Width="800"
        Style="{StaticResource AnipardWindowStyle}"
        StateChanged="Window_StateChanged" Closing="Window_Closing"
        Topmost="{Binding AlwaysOnTop}" AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/icon.ico"
                        ToolTipText="RenderPard"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick"
                        Visibility="Collapsed">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource RestoreMenu}" Click="MenuItemRestore_Click"/>
                    <MenuItem Header="{DynamicResource ExitMenu}" Click="MenuItemExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="{DynamicResource AppTitle}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" Opacity="0.6" WindowChrome.IsHitTestVisibleInChrome="False"/>
                    <Button Content="—" Click="Minimize_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource AppTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    
                    <ToggleButton IsChecked="{Binding AlwaysOnTop}" Margin="0,0,10,0" Width="24" Height="24" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="ToolTip" Value="{DynamicResource AlwaysOnTopNormal}" />
                                <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4">
                                                <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" 
                                                      Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="14" Height="14"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="{DynamicResource AlwaysOnTopActive}" />
                                        <Setter Property="Foreground" Value="{StaticResource AppLinkBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding CreateSubfolderForFiles}" Margin="0,0,10,0" Width="24" Height="24" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="ToolTip" Value="{DynamicResource SubfolderDisabled}" />
                                <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4">
                                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                                      Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="16" Height="16"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="{DynamicResource SubfolderEnabled}" />
                                        <Setter Property="Foreground" Value="{StaticResource AppLinkBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Button Command="{Binding OpenQuickTrimCommand}" Margin="0,0,8,0" Height="22" Padding="8,0" Background="Transparent" Foreground="{StaticResource AppTextBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Cursor="Hand" ToolTip="{DynamicResource TrimQuickButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✂" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource AppLinkBrush}"/>
                            <TextBlock Text="{DynamicResource TrimCutButton}" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleMenuCommand}" Margin="0,0,8,0" Height="22" Padding="8,0" Background="Transparent" Foreground="{StaticResource AppTextBrush}" BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="{DynamicResource RegisterMenuShort}" />
                                <Setter Property="ToolTip" Value="{DynamicResource RegisterMenuTooltip}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMenuRegistered}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource RemoveMenuShort}" />
                                        <Setter Property="ToolTip" Value="{DynamicResource RemoveMenuTooltip}" />
                                        <Setter Property="Foreground" Value="{StaticResource AppLinkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="{DynamicResource MenuSettings}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="⋮" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,-2,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>
            
            <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                      Background="{StaticResource AppBackgroundSecondaryBrush}" Foreground="{StaticResource AppTextBrush}"
                      BorderBrush="{StaticResource AppBorderBrush}" RowBackground="{StaticResource AppBackgroundSecondaryBrush}"
                      AlternatingRowBackground="{StaticResource AppBackgroundBrush}" HeadersVisibility="Column">
                <!-- Simple styling for DataGrid to fit dark theme -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource ColFile}" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource AppTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center"/>
                                    <Border Background="#2B2414" CornerRadius="3" BorderBrush="#F39C12" BorderThickness="1" Margin="4,0,0,0" Padding="4,1" VerticalAlignment="Center" Visibility="{Binding IsTrimmed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding TrimSummary}" Foreground="#F39C12" FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#1A2D22" CornerRadius="3" BorderBrush="#2ECC71" BorderThickness="1" Margin="4,0,0,0" Padding="4,1" VerticalAlignment="Center" Visibility="{Binding IsCropped, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CropSummary}" Foreground="#2ECC71" FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource ColPreset}" Binding="{Binding Preset.Name}" Width="120"/>
                    <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="{DynamicResource ColProgress}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="10" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource AppLinkBrush}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:P1}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#111111" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource ColError}" Binding="{Binding ErrorMessage}" Width="*"/>
                    <DataGridTemplateColumn Header="{DynamicResource ColAction}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.TrimTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{DynamicResource TrimCutButton}" Padding="4" Margin="0,0,4,0">
                                        <TextBlock Text="✂" Foreground="{StaticResource AppLinkBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{DynamicResource RemoveTaskTooltip}" Padding="4">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Fill="{StaticResource AppTextSecondaryBrush}" Width="15" Height="15" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Live GitHub In-App Background Updater (Telegram-style) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Downloading state -->
                    <Border Background="#1C2028" CornerRadius="4" BorderBrush="#333846" BorderThickness="1" Padding="8,4" Margin="0,0,10,0" Visibility="{Binding IsUpdateDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding OpenUpdateDetailsCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Нажмите для подробностей загрузки" Padding="0" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⬇" Foreground="{StaticResource AppLinkBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource AppTextBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateDownloadProgress, Mode=OneWay}" Height="3" Width="200" Margin="0,3,0,0" Background="#242833" Foreground="{StaticResource AppLinkBrush}" BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CancelUpdateDownloadCommand}" ToolTip="Отменить загрузку" Background="Transparent" BorderThickness="0" Foreground="#A0E74C3C" FontSize="11" Cursor="Hand" Padding="4,0" VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Ready to install state -->
                    <Button Command="{Binding ApplyUpdateAndRestartCommand}" Background="#2ECC71" Foreground="#0E2314" BorderThickness="0" Padding="10,4" Margin="0,0,10,0" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="Нажмите, чтобы закрыть программу и завершить обновление" Visibility="{Binding IsUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🚀 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateReadyText}" VerticalAlignment="Center"/>
                            <TextBlock Text=" → Перезапустить" Margin="4,0,0,0" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Queue Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ToggleQueueCommand}" Width="30" Height="24" Margin="0,0,6,0" ToolTip="{DynamicResource PlayPauseTooltip}" Background="Transparent" Foreground="{StaticResource AppTextBrush}" BorderThickness="0" Cursor="Hand">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{StaticResource AppTextBrush}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQueueActive}" Value="True">
                                                    <Setter Property="Data" Value="M14,19H18V5H14M6,19H10V5H6V19Z"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Content="{DynamicResource ClearCompleted}" Command="{Binding ClearAllCommand}" Width="120" Height="24" Margin="0,0,6,0" HorizontalContentAlignment="Center"/>
                    <Button Content="{DynamicResource CancelAll}" Command="{Binding CancelAllCommand}" Width="100" Height="24" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- FFmpeg Missing Overlay -->
            <Border Grid.RowSpan="3" Background="#AA1E1E1E" Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{StaticResource AppBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" CornerRadius="12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FfmpegMissingTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource FfmpegMissingDesc}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,25"/>
                        <Button Content="{DynamicResource DownloadFfmpeg}" Command="{Binding DownloadFfmpegCommand}" Width="200"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- FFmpeg Downloading Overlay -->
            <Border Grid.RowSpan="3" Background="#AA1E1E1E" Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{StaticResource AppBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" CornerRadius="12" Width="400" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DownloadingFfmpeg}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadProgress}" Height="8" Margin="0,0,0,15" BorderThickness="0" Background="{StaticResource AppBackgroundSecondaryBrush}" Foreground="{StaticResource AppLinkBrush}"/>
                        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:P1}}" HorizontalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>

