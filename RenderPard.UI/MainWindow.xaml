<Window x:Class="RenderPard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        mc:Ignorable="d"
        Title="RenderPard Queue" Height="450" Width="800"
        Style="{StaticResource AnipardWindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="0">
            <Grid>
                <TextBlock Text="RenderPard Queue" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Click="Minimize_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                    <Button Content="✕" Click="Close_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Tasks Queue" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="3" HorizontalAlignment="Right">
                    <Button Content="Register Menu" Command="{Binding RegisterMenuCommand}" Margin="0,0,10,0"/>
                    <Button Content="Remove Menu" Command="{Binding UnregisterMenuCommand}" Margin="0,0,10,0"/>
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
            
            <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                      Background="{StaticResource AppBackgroundSecondaryBrush}" Foreground="{StaticResource AppTextBrush}"
                      BorderBrush="{StaticResource AppBorderBrush}" RowBackground="{StaticResource AppBackgroundSecondaryBrush}"
                      AlternatingRowBackground="{StaticResource AppBackgroundBrush}" HeadersVisibility="Column">
                <!-- Simple styling for DataGrid to fit dark theme -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="250"/>
                    <DataGridTextColumn Header="Preset" Binding="{Binding Preset.Name}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="Progress" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="15" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource AppLinkBrush}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:P1}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="White"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="*"/>
                    <DataGridTemplateColumn Header="Action" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource AppTextSecondaryBrush}" BorderThickness="0" Cursor="Hand" ToolTip="Remove Task"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Clear Completed/Pending" Command="{Binding ClearAllCommand}" Width="180" Margin="0,0,10,0"/>
                <Button Content="Cancel All" Command="{Binding CancelAllCommand}" Width="120"/>
            </StackPanel>

            <!-- FFmpeg Missing Overlay -->
            <Border Grid.RowSpan="3" Background="#AA1E1E1E" Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{StaticResource AppBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" CornerRadius="12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="FFmpeg is Missing" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <TextBlock Text="RenderPard requires FFmpeg to transcode videos.&#x0a;Would you like to download it now from the official source?" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,25"/>
                        <Button Content="Download FFmpeg" Command="{Binding DownloadFfmpegCommand}" Width="200"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- FFmpeg Downloading Overlay -->
            <Border Grid.RowSpan="3" Background="#AA1E1E1E" Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{StaticResource AppBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" CornerRadius="12" Width="400" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Downloading FFmpeg..." FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DownloadStatus}" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding DownloadProgress}" Height="8" Margin="0,0,0,15" BorderThickness="0" Background="{StaticResource AppBackgroundSecondaryBrush}" Foreground="{StaticResource AppLinkBrush}"/>
                        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:P1}}" HorizontalAlignment="Center" Foreground="{StaticResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
