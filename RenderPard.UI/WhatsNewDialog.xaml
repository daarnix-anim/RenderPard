<Window x:Class="RenderPard.UI.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WhatsNewTitle}" Height="540" Width="560" 
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" MinWidth="500" MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}"
        Style="{StaticResource AnipardWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0" Background="{StaticResource AppBackgroundSecondaryBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="✨" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleHeaderText" Text="{DynamicResource WhatsNewTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="✕" Click="BtnClose_Click" Width="40" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="12" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero: App Description & Tagline (1 sentence summary) -->
            <Border Grid.Row="0" Background="#16181D" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" Background="#222730" CornerRadius="8" BorderBrush="#3A404D" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="RenderPard" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="#2B2414" CornerRadius="4" BorderBrush="#F39C12" BorderThickness="1" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText" Text="v1.5.8" Foreground="#F39C12" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        
                        <!-- Concise Tagline (One sentence overview) -->
                        <TextBlock Text="{DynamicResource AppTagline}" TextWrapping="Wrap" Foreground="{StaticResource AppTextBrush}" FontSize="12" FontWeight="SemiBold" LineHeight="17" Margin="0,2,0,4"/>
                        <TextBlock Text="{DynamicResource WhatsNewSectionCoreDesc}" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondaryBrush}" FontSize="11" LineHeight="15"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Release Highlights Box -->
            <Border Grid.Row="1" Background="{StaticResource AppBackgroundSecondaryBrush}" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource WhatsNewSectionFeaturesTitle}" Foreground="#F39C12" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Feature 1 -->
                            <Border Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource WhatsNewFeature1}" Foreground="{StaticResource AppTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>

                            <!-- Feature 2 -->
                            <Border Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource WhatsNewFeature2}" Foreground="{StaticResource AppTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>

                            <!-- Feature 3 -->
                            <Border Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource WhatsNewFeature3}" Foreground="{StaticResource AppTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>

                            <!-- Feature 4 -->
                            <Border Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource WhatsNewFeature4}" Foreground="{StaticResource AppTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>

                            <!-- Feature 5 -->
                            <Border Background="#16181D" CornerRadius="6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,8">
                                <TextBlock Text="{DynamicResource WhatsNewFeature5}" Foreground="{StaticResource AppTextBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource AppBackgroundSecondaryBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource WhatsNewBtnGitHub}" Click="BtnGitHub_Click" Height="34" Padding="14,0" Background="#20242B" Foreground="{StaticResource AppTextSecondaryBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="{DynamicResource WhatsNewBtnGetStarted}" Click="BtnClose_Click" Height="34" Padding="20,0" Background="#F39C12" Foreground="#111111" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
