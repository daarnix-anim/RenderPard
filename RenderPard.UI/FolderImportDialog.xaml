<Window x:Class="RenderPard.UI.FolderImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenderPard.UI"
        xmlns:viewmodels="clr-namespace:RenderPard.UI.ViewModels"
        mc:Ignorable="d"
        Title="Выбор форматов для конвертации" Height="400" Width="400"
        Style="{DynamicResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите форматы файлов для добавления в очередь:" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Extensions}" Background="{DynamicResource DarkPanelBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,5">
                        <TextBlock Foreground="{DynamicResource TextBrush}">
                            <Run Text="{Binding Extension, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" (найдено: "/>
                            <Run Text="{Binding Count, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Left">
            <Button Content="Выбрать все" Click="SelectAll_Click" Style="{DynamicResource SmallButtonStyle}" Margin="0,0,10,0" Width="100"/>
            <Button Content="Снять все" Click="DeselectAll_Click" Style="{DynamicResource SmallButtonStyle}" Width="100"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Style="{DynamicResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Добавить в очередь" Click="Add_Click" Style="{DynamicResource PrimaryButtonStyle}" Width="150"/>
        </StackPanel>
    </Grid>
</Window>
